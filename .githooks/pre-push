#!/bin/sh
# Runs the public-site check before pushing to publish/* or main (see AGENTS.md).
# Enable once per clone:  git config core.hooksPath .githooks
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/publish/*|refs/heads/main) ;;
    *) continue ;;
  esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch deletion
  tmp=$(mktemp -d)
  git archive "$local_sha" docs tools | tar -x -C "$tmp"
  echo "check-public: ${remote_ref#refs/heads/}"
  (cd "$tmp" && python3 tools/check-public.py docs) || status=1
  rm -rf "$tmp"
done
[ $status -eq 0 ] || echo "Push refused. Fix the above, or bypass with: git push --no-verify"
exit $status
